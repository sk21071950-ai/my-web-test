// 1. 체스 엔진 및 보드 초기화
const game = new Chess();
const board = ChessBoard('board', {
  draggable: false, // 마우스 드래그 금지 (제스처로만 조작)
  position: 'start'
});

let selectedSquare = null; // 현재 선택된 체스 칸 (예: 'e2')
let hoveredSquare = null;  // 손가락 커서가 위치한 체스 칸
const statusEl = document.getElementById('gesture-status');

// 2. 가상 마우스/커서 위치를 바탕으로 체스판의 칸(Square) 계산 함수
function getSquareFromCoords(x, y) {
    const boardEl = document.getElementById('board');
    const rect = boardEl.getBoundingClientRect();
    
    // 체스판 영역 내부인지 확인
    if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
        const colWidth = rect.width / 8;
        const rowHeight = rect.height / 8;
        
        const colIndex = Math.floor((x - rect.left) / colWidth);
        const rowIndex = Math.floor((y - rect.top) / rowHeight);
        
        const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
        const ranks = ['8', '7', '6', '5', '4', '3', '2', '1']; // 체스판 상단이 8번 행
        
        return files[colIndex] + ranks[rowIndex];
    }
    return null;
}

// 3. 간단한 제스처 판단 알고리즘 (주먹 여부 판별)
function detectGesture(landmarks) {
    // MediaPipe Hand Landmarks: 4(엄지팁), 8(검지팁), 12(중지팁), 0(손목)
    const wrist = landmarks[0];
    const indexTip = landmarks[8];
    const middleTip = landmarks[12];
    
    // 손목과 손가락 끝의 거리를 계산하여 주먹 상태 정의 (임계값은 환경에 맞게 조정)
    const distIndex = Math.hypot(indexTip.x - wrist.x, indexTip.y - wrist.y);
    
    // 검지가 접혀있으면 PINCH/GRAB (선택), 펴져 있으면 MOVE (이동)
    if (distIndex < 0.25) {
        return 'GRAB';
    }
    return 'HOVER';
}

// 4. MediaPipe Hands 결과 처리 콜백
function onResults(results) {
    if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
        statusEl.innerText = "손을 카메라에 보여주세요.";
        return;
    }

    const landmarks = results.multiHandLandmarks[0]; // 첫 번째 손 기준
    const indexTip = landmarks[8]; // 검지 손가락 끝 좌표
    
    // 화면 크기에 맞게 좌표 변환 (반전 반영)
    const cursorX = window.innerWidth - (indexTip.x * window.innerWidth);
    const cursorY = indexTip.y * window.innerHeight;
    
    // 현재 손가락이 가리키는 칸 확인
    hoveredSquare = getSquareFromCoords(cursorX, cursorY);
    const gesture = detectGesture(landmarks);
    
    if (!hoveredSquare) {
        statusEl.innerText = `체스판 밖을 가리키고 있습니다. (${gesture})`;
        return;
    }

    if (gesture === 'GRAB') {
        // 주먹을 쥐었을 때: 기물이 있고 아직 선택하지 않았다면 선택
        if (!selectedSquare) {
            const piece = game.get(hoveredSquare);
            if (piece) {
                selectedSquare = hoveredSquare;
                statusEl.innerText = `✊ [기물 선택됨]: ${selectedSquare}의 ${piece.type.toUpperCase()}`;
                // 체스판 비주얼 하이라이트 효과 등을 여기에 추가 가능
            } else {
                statusEl.innerText = `❌ ${hoveredSquare} 칸에는 기물이 없습니다.`;
            }
        }
    } else if (gesture === 'HOVER') {
        // 손을 폈을 때: 이미 기물을 선택한 상태였다면 해당 칸으로 이동 시도
        if (selectedSquare) {
            const move = game.move({
                from: selectedSquare,
                to: hoveredSquare,
                promotion: 'q' // 폰 프로모션 발생 시 기본 퀸으로 변환
            });
            
            if (move) {
                board.position(game.fen()); // 보드 그래픽 업데이트
                statusEl.innerText = `🖐️ [이동 성공]: ${selectedSquare} ➡️ ${hoveredSquare}`;
            } else {
                statusEl.innerText = `⚠️ 올바르지 않은 체스 규칙 이동입니다. (재시도하세요)`;
            }
            selectedSquare = null; // 선택 상태 초기화
        } else {
            statusEl.innerText = `🔍 탐색 중: 현재 위치 [ ${hoveredSquare} ]`;
        }
    }
}

// 5. MediaPipe 카메라 설정 및 파이프라인 연결
const hands = new Hands({
  locateFile: (file) => `https://jsdelivr.net{file}`
});

hands.setOptions({
  maxNumHands: 1,
  modelComplexity: 1,
  minDetectionConfidence: 0.7,
  minTrackingConfidence: 0.7
});
hands.onResults(onResults);

const videoElement = document.getElementById('webcam');
const camera = new Camera(videoElement, {
  onFrame: async () => {
    await hands.send({image: videoElement});
  },
  width: 400,
  height: 300
});
camera.start();
